# Django Environment Configuration
DJANGO_ENV=development
DJANGO_SECRET_KEY=django-insecure-myfinance-super-secret-key-change-in-prod-xyz789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Branding (Configurable)
APP_NAME=MyFinance
APP_CODE=MYFINANCE
SUPPORT_EMAIL=support@myfinance.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://myfinance_user:myfinance_pass@localhost:5432/myfinance_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / Flutter Clients
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (Production only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
